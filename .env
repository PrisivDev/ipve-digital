# ================================================================
# IPVE Digital — Environment Variables
# ================================================================

# Auth
NEXTAUTH_SECRET=ipve-dev-secret-key-change-in-production-32chars
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=ipve-jwt-secret-change-in-production-32chars

# ================================================================
# Supabase — PostgreSQL Database (Prisma)
# ================================================================
# DATABASE_URL : Connection pooler URL (port 6543) — used by Prisma Client at runtime
# DIRECT_URL  : Direct connection URL (port 5432) — used by Prisma Migrate / db push
# Get these from: Supabase Dashboard → Settings → Database → Connection string
#
# Example format:
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_PASSWORD@aws-0-REPLACE_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://postgres.REPLACE_PROJECT_REF:REPLACE_PASSWORD@aws-0-REPLACE_REGION.supabase.com:5432/postgres"

# ================================================================
# Supabase — Storage (for avatars, logos, uploads)
# ================================================================
# Get these from: Supabase Dashboard → Settings → API
#
# NEXT_PUBLIC_SUPABASE_URL        : The project URL (e.g. https://xxxx.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY       : The service_role key (has admin access)
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVICE_ROLE_KEY

# ================================================================
# App Config
# ================================================================
NEXT_PUBLIC_APP_NAME=IPVE Digital
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ================================================================
# IPVE Digital — Environment Variables
# Copy this file to .env and adjust values for your environment.
# ================================================================

# Database — SQLite (local file, no external server needed)
DATABASE_URL=file:./db/custom.db

# JWT Authentication — Change this in production!
JWT_SECRET=ipve-digital-secret-key-2024-change-in-production

# App branding
NEXT_PUBLIC_APP_NAME=IPVE Digital

# ================================================================
# OPTIONAL — Supabase (for file storage: logos, avatars, etc.)
# Not required for core functionality. Leave empty to disable.
# ================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

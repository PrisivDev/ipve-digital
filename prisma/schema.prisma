// ================================================================
// IPVE DIGITAL - Schéma Prisma ORM Complet (SQLite)
// Institut Polytechnique Vase d'Élites - Abidjan, Côte d'Ivoire
// Comptabilité OHADA • Multi-tenant
// ================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ================================================================
// ENUM NOTES (for reference — stored as String in SQLite)
// ================================================================
// RoleName: ADMIN, TEACHER, ACCOUNTANT, CASHIER, SECRETARY, PARENT, STUDENT
// PermissionModule: CRM, ERP, LMS, SETTINGS, REPORTS
// PermissionAction: CREATE, READ, UPDATE, DELETE, EXPORT, VALIDATE
// ProspectSource: WEBSITE, RECOMMENDATION, SOCIAL_MEDIA, FACEBOOK, WHATSAPP, WALK_IN, EVENT, ADVERTISEMENT, PARTNER, OTHER
// ProspectStatus: NOUVEAU, CONTACTE, INTERESSE, DOSSIER_RECU, ADMIS, CONVERTI, ABANDONNE
// StudentStatus: ENROLLED, ACTIVE, SUSPENDED, GRADUATED, TRANSFERRED, DROPPED
// Gender: MALE, FEMALE
// EvaluationType: DEVOIR, COMPOSITION, TP, EXAMEN, PROJET, PARTICIPATION
// AttendanceStatus: PRESENT, ABSENT, LATE, EXCUSED, SUSPENDED
// DayOfWeek: MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY
// PaymentMethod: CASH, MTN_MOMO, ORANGE_MONEY, WAVE, BANK_TRANSFER, CHEQUE
// PaymentStatus: PENDING, COMPLETED, PARTIALLY_REFUNDED, REFUNDED, CANCELLED
// ExpenseStatus: PENDING, APPROVED, PAID, REJECTED, CANCELLED
// JournalType: SALES, PURCHASES, BANK, CASH, OD, GENERAL
// ReferenceType: PAYMENT, EXPENSE, PAYROLL, ADJUSTMENT, INVOICE
// AccountType: ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
// NormalBalance: DEBIT, CREDIT
// ContractType: CDI, CDD, INTERIM, FREELANCE, STAGE
// Department: DIRECTION, ACADEMIQUE, FINANCIER, ADMINISTRATIF, INFORMATIQUE
// PayrollStatus: DRAFT, PENDING_VALIDATION, VALIDATED, PAID, CANCELLED
// SyncOperation: CREATE, UPDATE, DELETE
// SyncStatus: PENDING, SYNCED, CONFLICT, FAILED
// NotificationType: INFO, SUCCESS, WARNING, ERROR, PAYMENT_REMINDER, GRADE_PUBLISHED, ABSENCE_ALERT
// AdmissionStatus: DRAFT, SUBMITTED, UNDER_REVIEW, ACCEPTED, REJECTED, CANCELLED, ENROLLED
// StudentCardStatus: ACTIVE, LOST, EXPIRED, CANCELLED

// ================================================================
// 1. AUTH & USERS
// ================================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  roleId        String
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  phone         String?
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  lastLogin     DateTime? @map("last_login")
  totpSecret    String?   @map("totp_secret")
  totpEnabled   Boolean   @default(false) @map("totp_enabled")
  totpVerifiedAt DateTime? @map("totp_verified_at")
  syncVersion   Int       @default(0) @map("sync_version")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  role                  Role                   @relation(fields: [roleId], references: [id])
  auditLogs             AuditLog[]
  gradeEntries          Grade[]                @relation("TeacherGrades")
  gradeValidations      Grade[]                @relation("GradeValidator")
  paymentsReceived      Payment[]              @relation("PaymentReceiver")
  expensesApproved      Expense[]              @relation("ExpenseApprover")
  expensesEntered       Expense[]              @relation("ExpenseCreator")
  journalEntriesCreated JournalEntry[]         @relation("JournalCreator")
  journalEntriesValidated JournalEntry[]       @relation("JournalValidator")
  payrollValidations    PayrollRun[]           @relation("PayrollValidator")
  attendanceRecords     Attendance[]           @relation("AttendanceRecorder")
  notifications         Notification[]         @relation("UserNotifications")
  syncLogs              SyncLog[]
  classSubjects         ClassSubject[]         @relation("TeacherClassSubject")
  schedules             Schedule[]
  studentProfile        Student?               @relation("StudentUser")
  employeeProfile       Employee?              @relation("EmployeeUser")
  prospectsAssigned     Prospect[]             @relation("ProspectAssignee")
  interactionsRecorded  ProspectInteraction[]  @relation("InteractionRecorder")
  admissionsReviewed    Admission[]            @relation("AdmissionReviewer")

  @@index([email])
  @@index([roleId])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  module    String
  action    String
  resource  String
  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([module, action, resource])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ================================================================
// 2. CRM
// ================================================================

model Prospect {
  id                String    @id @default(uuid())
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  email             String?
  phone             String
  source            String    @default("OTHER")
  status            String    @default("NOUVEAU")
  filiereInterest   String?   @map("filiere_interest")
  levelInterest     String?   @map("level_interest")
  notes             String?
  assignedTo        String?
  convertedAt       DateTime? @map("converted_at")
  convertedStudentId String?  @unique @map("converted_student_id")
  dateOfBirth       DateTime? @map("date_of_birth")
  gender            String    @default("MALE")
  nationality       String    @default("Ivoirienne")
  address           String?
  parentName        String?   @map("parent_name")
  parentPhone       String?   @map("parent_phone")
  parentEmail       String?   @map("parent_email")
  lastContactAt     DateTime? @map("last_contact_at")
  syncVersion       Int       @default(0) @map("sync_version")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  assignedToUser   User?                @relation("ProspectAssignee", fields: [assignedTo], references: [id])
  convertedStudent Student?             @relation("ProspectConversion", fields: [convertedStudentId], references: [id])
  interactions     ProspectInteraction[]

  @@index([status])
  @@index([source])
  @@index([assignedTo])
  @@index([phone])
  @@index([lastContactAt])
  @@map("prospects")
}

model ProspectInteraction {
  id          String   @id @default(uuid())
  prospectId  String   @map("prospect_id")
  type        String   @default("NOTE")
  subject     String?
  content     String
  direction   String?  @default("OUTGOING")
  conductedBy String?  @map("conducted_by")
  createdAt   DateTime @default(now()) @map("created_at")

  prospect        Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  conductedByUser User?    @relation("InteractionRecorder", fields: [conductedBy], references: [id])

  @@index([prospectId])
  @@index([type])
  @@map("prospect_interactions")
}

model Student {
  id               String    @id @default(uuid())
  studentNumber    String    @unique @map("student_number")
  userId           String?   @unique @map("user_id")
  firstName        String    @map("first_name")
  lastName         String    @map("last_name")
  dateOfBirth      DateTime? @map("date_of_birth")
  gender           String    @default("MALE")
  nationality      String    @default("Ivoirienne")
  address          String?
  photoUrl         String?   @map("photo_url")
  enrollmentDate   DateTime? @map("enrollment_date")
  status           String    @default("ENROLLED") @map("status")
  filiereId        String?   @map("filiere_id")
  levelId          String?   @map("level_id")
  classId          String?   @map("class_id")
  parentName       String?   @map("parent_name")
  parentPhone      String?   @map("parent_phone")
  parentEmail      String?   @map("parent_email")
  emergencyContact String?   @map("emergency_contact")
  medicalNotes     String?   @map("medical_notes")
  scholarship      Boolean   @default(false) @map("scholarship")
  scholarshipPct   Float?    @map("scholarship_pct")
  syncVersion      Int       @default(0) @map("sync_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user                 User?       @relation("StudentUser", fields: [userId], references: [id])
  filiere              Filiere?    @relation(fields: [filiereId], references: [id])
  level                Level?      @relation(fields: [levelId], references: [id])
  class                Class?      @relation(fields: [classId], references: [id])
  grades               Grade[]
  attendance           Attendance[]
  payments             Payment[]
  prospectConversion   Prospect?   @relation("ProspectConversion")
  admissionEnrollment  Admission?  @relation("AdmissionEnrollment")
  studentCards         StudentCard[]

  @@index([studentNumber])
  @@index([status])
  @@index([filiereId])
  @@index([levelId])
  @@index([classId])
  @@index([lastName, firstName])
  @@index([userId])
  @@map("students")
}

// ================================================================
// 3. ACADÉMIQUE
// ================================================================

model Filiere {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  description   String?
  durationYears Int      @default(3) @map("duration_years")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  levels    Level[]
  students  Student[]
  admissions Admission[]

  @@index([code])
  @@index([isActive])
  @@map("filieres")
}

model Level {
  id          String   @id @default(uuid())
  name        String
  filiereId   String   @map("filiere_id")
  yearNumber  Int      @map("year_number")
  tuitionFee  Float    @default(0) @map("tuition_fee")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  filiere       Filiere  @relation(fields: [filiereId], references: [id])
  classes       Class[]
  students      Student[]
  paymentPlans  PaymentPlan[]
  admissions    Admission[]

  @@unique([filiereId, yearNumber])
  @@index([filiereId])
  @@map("levels")
}

model AcademicYear {
  id          String   @id @default(uuid())
  name        String
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isCurrent   Boolean  @default(false) @map("is_current")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  classes       Class[]
  periods       Period[]
  schedules     Schedule[]
  paymentPlans  PaymentPlan[]

  @@index([isCurrent])
  @@map("academic_years")
}

model Class {
  id             String   @id @default(uuid())
  name           String
  levelId        String   @map("level_id")
  capacity       Int      @default(40)
  room           String?
  academicYearId String   @map("academic_year_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  level         Level         @relation(fields: [levelId], references: [id])
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id])
  students      Student[]
  classSubjects ClassSubject[]
  grades        Grade[]
  attendance    Attendance[]
  schedules     Schedule[]

  @@index([levelId])
  @@index([academicYearId])
  @@map("classes")
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  classSubjects ClassSubject[]

  @@index([code])
  @@index([isActive])
  @@map("subjects")
}

model ClassSubject {
  id           String   @id @default(uuid())
  classId      String   @map("class_id")
  subjectId    String   @map("subject_id")
  teacherId    String?  @map("teacher_id")
  coefficient  Float    @default(1.0)
  hoursPerWeek Int      @default(2) @map("hours_per_week")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  class      Class    @relation(fields: [classId], references: [id])
  subject    Subject  @relation(fields: [subjectId], references: [id])
  teacher    User?    @relation("TeacherClassSubject", fields: [teacherId], references: [id])
  grades     Grade[]
  attendance Attendance[]
  schedules  Schedule[]

  @@unique([classId, subjectId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@map("class_subjects")
}

model Period {
  id             String   @id @default(uuid())
  name           String
  academicYearId String   @map("academic_year_id")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  weight         Float    @default(1)
  sortOrder      Int      @default(0) @map("sort_order")
  isCurrent      Boolean  @default(false) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  grades       Grade[]

  @@index([academicYearId])
  @@index([isCurrent])
  @@map("periods")
}

model Grade {
  id             String   @id @default(uuid())
  studentId      String   @map("student_id")
  subjectId      String   @map("subject_id")
  classId        String   @map("class_id")
  academicYearId String   @map("academic_year_id")
  periodId       String   @map("period_id")
  evaluationType String   @default("DEVOIR") @map("evaluation_type")
  score          Decimal
  maxScore       Decimal  @default(20) @map("max_score")
  coefficient    Decimal  @default(1)
  enteredBy      String?  @map("entered_by")
  isValidated    Boolean  @default(false) @map("is_validated")
  validatedBy    String?  @map("validated_by")
  comments       String?
  syncVersion    Int      @default(0) @map("sync_version")
  createdOffline Boolean  @default(false) @map("created_offline")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  student        Student       @relation(fields: [studentId], references: [id])
  classSubject   ClassSubject? @relation(fields: [subjectId], references: [id])
  class          Class         @relation(fields: [classId], references: [id])
  period         Period        @relation(fields: [periodId], references: [id])
  enteredByUser  User?         @relation("TeacherGrades", fields: [enteredBy], references: [id])
  validatedByUser User?        @relation("GradeValidator", fields: [validatedBy], references: [id])

  @@index([studentId])
  @@index([classId])
  @@index([periodId])
  @@index([evaluationType])
  @@index([isValidated])
  @@index([studentId, periodId])
  @@map("grades")
}

model Attendance {
  id           String   @id @default(uuid())
  studentId    String   @map("student_id")
  classId      String   @map("class_id")
  subjectId    String   @map("subject_id")
  date         DateTime
  status       String   @default("PRESENT")
  justification String?
  recordedBy   String?  @map("recorded_by")
  syncVersion  Int      @default(0) @map("sync_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  student        Student       @relation(fields: [studentId], references: [id])
  class          Class         @relation(fields: [classId], references: [id])
  classSubject   ClassSubject? @relation(fields: [subjectId], references: [id])
  recordedByUser User?         @relation("AttendanceRecorder", fields: [recordedBy], references: [id])

  @@unique([studentId, classId, subjectId, date])
  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([status])
  @@index([studentId, date])
  @@map("attendance")
}

model Schedule {
  id             String   @id @default(uuid())
  classId        String   @map("class_id")
  subjectId      String   @map("subject_id")
  teacherId      String?  @map("teacher_id")
  room           String?
  dayOfWeek      String   @map("day_of_week")
  startTime      String   @map("start_time")
  endTime        String   @map("end_time")
  academicYearId String   @map("academic_year_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  class         Class         @relation(fields: [classId], references: [id])
  classSubject  ClassSubject? @relation(fields: [subjectId], references: [id])
  teacher       User?         @relation(fields: [teacherId], references: [id])
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id])

  @@index([classId])
  @@index([teacherId])
  @@index([dayOfWeek])
  @@map("schedules")
}

// ================================================================
// 4. FINANCIER
// ================================================================

model PaymentPlan {
  id             String   @id @default(uuid())
  name           String
  levelId        String   @map("level_id")
  academicYearId String   @map("academic_year_id")
  totalAmount    Decimal  @map("total_amount")
  currency       String   @default("XOF")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  level        Level              @relation(fields: [levelId], references: [id])
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id])
  tranches     PaymentPlanTranche[]

  @@index([levelId])
  @@index([academicYearId])
  @@index([levelId, academicYearId, isActive])
  @@map("payment_plans")
}

model PaymentPlanTranche {
  id            String   @id @default(uuid())
  planId        String   @map("plan_id")
  trancheNumber Int      @map("tranche_number")
  name          String
  amount        Decimal
  dueDate       DateTime? @map("due_date")
  isMandatory   Boolean  @default(true) @map("is_mandatory")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  plan     PaymentPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@unique([planId, trancheNumber])
  @@index([planId])
  @@map("payment_plan_tranches")
}

model Payment {
  id              String   @id @default(uuid())
  paymentNumber   String   @unique @map("payment_number")
  studentId       String   @map("student_id")
  trancheId       String   @map("tranche_id")
  amountPaid      Decimal  @map("amount_paid")
  paymentDate     DateTime @map("payment_date")
  paymentMethod   String   @map("payment_method")
  referenceNumber String?  @map("reference_number")
  receivedBy      String?  @map("received_by")
  notes           String?
  receiptUrl      String?  @map("receipt_url")
  status          String   @default("PENDING")
  syncVersion     Int      @default(0) @map("sync_version")
  createdOffline  Boolean  @default(false) @map("created_offline")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  student        Student           @relation(fields: [studentId], references: [id])
  tranche        PaymentPlanTranche @relation(fields: [trancheId], references: [id])
  receivedByUser User?             @relation("PaymentReceiver", fields: [receivedBy], references: [id])

  @@index([studentId])
  @@index([paymentDate])
  @@index([status])
  @@index([paymentMethod])
  @@index([studentId, trancheId])
  @@index([trancheId, status])
  @@map("payments")
}

model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String
  code        String?
  description String?
  budgetLimit Float    @default(0) @map("budget_limit")
  isActive    Boolean  @default(true) @map("is_active")
  parentId    String?  @map("parent_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   ExpenseCategory?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ExpenseCategory[] @relation("CategoryHierarchy")
  expenses Expense[]

  @@index([parentId])
  @@map("expense_categories")
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contact       String?
  phone         String?
  email         String?
  address       String?
  contactPerson String?  @map("contact_person")
  rib           String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  expenses Expense[]

  @@map("suppliers")
}

model Expense {
  id            String   @id @default(uuid())
  expenseNumber String   @unique @map("expense_number")
  categoryId    String   @map("category_id")
  description   String
  amount        Decimal
  expenseDate   DateTime @map("expense_date")
  supplierId    String?  @map("supplier_id")
  invoiceNumber String?  @map("invoice_number")
  invoiceUrl    String?  @map("invoice_url")
  paymentMethod String   @map("payment_method")
  approvedBy    String?  @map("approved_by")
  enteredBy     String?  @map("entered_by")
  status        String   @default("PENDING")
  syncVersion   Int      @default(0) @map("sync_version")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category       ExpenseCategory @relation(fields: [categoryId], references: [id])
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  approvedByUser User?           @relation("ExpenseApprover", fields: [approvedBy], references: [id])
  enteredByUser  User?           @relation("ExpenseCreator", fields: [enteredBy], references: [id])

  @@index([categoryId])
  @@index([expenseDate])
  @@index([status])
  @@map("expenses")
}

// ================================================================
// 5. COMPTABILITÉ OHADA
// ================================================================

model ChartOfAccount {
  id            String   @id @default(uuid())
  accountNumber String   @unique @map("account_number")
  accountName   String   @map("account_name")
  accountClass  String   @map("account_class")
  accountType   String   @map("account_type")
  parentId      String?  @map("parent_id")
  isActive      Boolean  @default(true) @map("is_active")
  normalBalance String   @map("normal_balance")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  parent       ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     ChartOfAccount[] @relation("AccountHierarchy")
  journalLines JournalEntryLine[]

  @@index([accountNumber])
  @@index([accountClass])
  @@index([accountType])
  @@index([isActive])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id            String   @id @default(uuid())
  entryNumber   String   @unique @map("entry_number")
  entryDate     DateTime @map("entry_date")
  description   String
  journalType   String   @map("journal_type")
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  isValidated   Boolean  @default(false) @map("is_validated")
  createdBy     String?  @map("created_by")
  validatedBy   String?  @map("validated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  lines           JournalEntryLine[]
  createdByUser   User? @relation("JournalCreator", fields: [createdBy], references: [id])
  validatedByUser User? @relation("JournalValidator", fields: [validatedBy], references: [id])

  @@index([entryDate])
  @@index([journalType])
  @@index([referenceType, referenceId])
  @@index([isValidated])
  @@map("journal_entries")
}

model JournalEntryLine {
  id           String   @id @default(uuid())
  entryId      String   @map("entry_id")
  accountId    String   @map("account_id")
  debitAmount  Decimal  @default(0) @map("debit_amount")
  creditAmount Decimal  @default(0) @map("credit_amount")
  description  String?
  lineOrder    Int      @map("line_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  entry   JournalEntry   @relation(fields: [entryId], references: [id])
  account ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// ================================================================
// 6. RH & PAIE
// ================================================================

model Employee {
  id                String   @id @default(uuid())
  userId            String?  @unique @map("user_id")
  employeeNumber    String   @unique @map("employee_number")
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  dateOfBirth       DateTime? @map("date_of_birth")
  hireDate          DateTime @map("hire_date")
  contractType      String   @map("contract_type")
  department        String   @default("ACADEMIQUE")
  position          String?
  baseSalary        Decimal  @map("base_salary")
  transportAllowance Decimal? @map("transport_allowance")
  housingAllowance  Decimal? @map("housing_allowance")
  bankName          String?  @map("bank_name")
  bankAccount       String?  @map("bank_account")
  cnpsNumber        String?  @map("cnps_number")
  taxId             String?  @map("tax_id")
  isActive          Boolean  @default(true) @map("is_active")
  terminationDate   DateTime? @map("termination_date")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user     User?     @relation("EmployeeUser", fields: [userId], references: [id])
  payslips Payslip[]

  @@index([employeeNumber])
  @@index([department])
  @@index([isActive])
  @@map("employees")
}

model PayrollRun {
  id                   String   @id @default(uuid())
  month                Int
  year                 Int
  status               String   @default("DRAFT")
  totalGross           Decimal  @default(0) @map("total_gross")
  totalDeductions      Decimal  @default(0) @map("total_deductions")
  totalNet             Decimal  @default(0) @map("total_net")
  totalEmployerCharges Decimal  @default(0) @map("total_employer_charges")
  validatedBy          String?  @map("validated_by")
  paymentDate          DateTime? @map("payment_date")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  payslips       Payslip[]
  validatedByUser User?   @relation("PayrollValidator", fields: [validatedBy], references: [id])

  @@unique([month, year])
  @@index([status])
  @@map("payroll_runs")
}

model Payslip {
  id                 String   @id @default(uuid())
  payrollRunId       String   @map("payroll_run_id")
  employeeId         String   @map("employee_id")
  baseSalary         Decimal  @map("base_salary")
  transportAllowance Decimal  @default(0) @map("transport_allowance")
  housingAllowance   Decimal  @default(0) @map("housing_allowance")
  otherBonuses       Decimal  @default(0) @map("other_bonuses")
  grossSalary        Decimal  @map("gross_salary")
  cnpsEmployee       Decimal  @default(0) @map("cnps_employee")
  itsTax             Decimal  @default(0) @map("its_tax")
  cmuEmployee        Decimal  @default(0) @map("cmu_employee")
  totalDeductions    Decimal  @default(0) @map("total_deductions")
  netSalary          Decimal  @map("net_salary")
  cnpsEmployer       Decimal  @default(0) @map("cnps_employer")
  accidentWork       Decimal  @default(0) @map("accident_work")
  taxProfessional    Decimal  @default(0) @map("tax_professional")
  fpc                Decimal  @default(0) @map("fpc")
  totalEmployerCost  Decimal  @default(0) @map("total_employer_cost")
  pdfUrl             String?  @map("pdf_url")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
  @@map("payslips")
}

// ================================================================
// 7. SYSTÈME
// ================================================================

model SyncLog {
  id                 String    @id @default(uuid())
  deviceId           String    @map("device_id")
  userId             String?   @map("user_id")
  operation          String
  tableName          String    @map("table_name")
  recordId           String    @map("record_id")
  payload            String
  syncVersion        Int       @map("sync_version")
  syncedAt           DateTime? @map("synced_at")
  status             String    @default("PENDING")
  conflictResolution String?   @map("conflict_resolution")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([deviceId])
  @@index([userId])
  @@index([tableName, recordId])
  @@index([status])
  @@map("sync_log")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  oldValues  String?  @map("old_values")
  newValues  String?  @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_log")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  metadata  String?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation("UserNotifications", fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

// ================================================================
// 8. SETTINGS & INSTITUTION
// ================================================================

model InstitutionSettings {
  id                      String   @id @default(uuid())
  schoolName              String   @default("Institut Polytechnique Vase d'Élites") @map("school_name")
  shortName               String   @default("IPVE") @map("short_name")
  motto                   String?  @default("Scientia Nobis Lumen")
  address                 String?  @default("Abidjan, Côte d'Ivoire")
  phone                   String?
  email                   String?  @default("infos@pve.edu.ci")
  website                 String?  @default("www.ipve.edu.ci")
  logoUrl                 String?  @map("logo_url")
  academicYear            String?  @map("academic_year")
  currency                String   @default("XOF")
  locale                  String   @default("fr-FR")
  // Security policies
  passwordMinLength       Int      @default(8) @map("password_min_length")
  passwordRequireUppercase Boolean  @default(true) @map("password_require_uppercase")
  passwordRequireNumbers  Boolean  @default(true) @map("password_require_numbers")
  passwordRequireSpecial  Boolean  @default(false) @map("password_require_special")
  sessionTimeoutMinutes   Int      @default(480) @map("session_timeout_minutes")
  maxLoginAttempts        Int      @default(5) @map("max_login_attempts")
  twoFactorEnforced       Boolean  @default(false) @map("two_factor_enforced")
  // Financial settings
  defaultPaymentMethod    String?  @default("CASH") @map("default_payment_method")
  latePenaltyPercent      Float    @default(0) @map("late_penalty_percent")
  gracePeriodDays         Int      @default(0) @map("grace_period_days")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("institution_settings")
}

// ================================================================
// 9. ADMISSIONS
// ================================================================

model Admission {
  id                String    @id @default(uuid())
  admissionNumber   String    @unique @map("admission_number")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  dateOfBirth       DateTime? @map("date_of_birth")
  gender            String    @default("MALE")
  nationality       String    @default("Ivoirienne")
  address           String?
  phone             String
  email             String?
  parentName        String?   @map("parent_name")
  parentPhone       String?   @map("parent_phone")
  parentEmail       String?   @map("parent_email")
  filiereId         String    @map("filiere_id")
  levelId           String    @map("level_id")
  previousSchool    String?   @map("previous_school")
  previousDiploma   String?   @map("previous_diploma")
  notes             String?
  status            String    @default("DRAFT")
  reviewedBy        String?   @map("reviewed_by")
  reviewedAt        DateTime? @map("reviewed_at")
  decisionNote      String?   @map("decision_note")
  enrolledStudentId String?   @unique @map("enrolled_student_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  filiere         Filiere  @relation(fields: [filiereId], references: [id])
  level           Level    @relation(fields: [levelId], references: [id])
  reviewedByUser  User?    @relation("AdmissionReviewer", fields: [reviewedBy], references: [id])
  enrolledStudent Student? @relation("AdmissionEnrollment", fields: [enrolledStudentId], references: [id])

  @@index([status])
  @@index([filiereId])
  @@index([levelId])
  @@index([phone])
  @@index([createdAt])
  @@map("admissions")
}

// ================================================================
// 10. STUDENT CARDS
// ================================================================

model StudentCard {
  id            String    @id @default(uuid())
  cardNumber    String    @unique @map("card_number")
  studentId     String    @map("student_id")
  status        String    @default("ACTIVE")
  issueDate     DateTime  @map("issue_date")
  expiryDate    DateTime? @map("expiry_date")
  printCount    Int       @default(0) @map("print_count")
  lastPrintedAt DateTime? @map("last_printed_at")
  revokedReason String?   @map("revoked_reason")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([cardNumber])
  @@map("student_cards")
}
